<Application x:Class="Vox.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Vox look "Notebook" (2026-11): warm graph paper, ink blue, a red margin and stamp.
      Fonts ship in Assets\Fonts (SIL Open Font License): Newsreader for words, IBM Plex Mono for labels, Segoe UI for controls.
    -->
    <Application.Resources>
        <!-- ===== palette ===== -->
        <Color x:Key="PaperColor">#F7F4EB</Color>
        <Color x:Key="InkColor">#1C2533</Color>
        <Color x:Key="BlueColor">#1F3A5F</Color>
        <Color x:Key="AccentColor">#1F3A5F</Color>
        <SolidColorBrush x:Key="Paper" Color="{StaticResource PaperColor}"/>
        <SolidColorBrush x:Key="Card" Color="#FCFBF7"/>
        <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}"/>
        <SolidColorBrush x:Key="Blue" Color="{StaticResource BlueColor}"/>
        <SolidColorBrush x:Key="BlueSoft" Color="#EEF2F8"/>
        <SolidColorBrush x:Key="Muted" Color="#56606E"/>
        <SolidColorBrush x:Key="Muted2" Color="#3D4A5C"/>
        <SolidColorBrush x:Key="Line" Color="#C9CFD8"/>
        <SolidColorBrush x:Key="Rule" Color="#B4432F"/>
        <SolidColorBrush x:Key="RuleSoft" Color="#80B4432F"/>
        <SolidColorBrush x:Key="Shadow" Color="#291F3A5F"/>
        <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#EEF2F8"/>
        <SolidColorBrush x:Key="Danger" Color="#B4432F"/>
        <SolidColorBrush x:Key="Good" Color="#2E7D4F"/>
        <SolidColorBrush x:Key="Amber" Color="#B7791F"/>
        <SolidColorBrush x:Key="Highlight" Color="#F2C14E"/>

        <!-- ===== fonts ===== -->
        <FontFamily x:Key="Serif">pack://application:,,,/Assets/Fonts/#Newsreader 16pt</FontFamily>
        <FontFamily x:Key="Mono">pack://application:,,,/Assets/Fonts/#IBM Plex Mono</FontFamily>
        <FontFamily x:Key="UI">Segoe UI</FontFamily>

        <!-- ===== graph paper: 24 px squares in faint ink ===== -->
        <DrawingBrush x:Key="GraphPaper" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute" Viewbox="0,0,24,24" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{StaticResource Paper}"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,24,24"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#111F3A5F"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,24,1"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#111F3A5F"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,24"/></GeometryDrawing.Geometry></GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource UI}"/></Style>

        <!-- ===== text styles ===== -->
        <Style x:Key="H1" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Serif}"/><Setter Property="FontSize" Value="30"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
        <Style x:Key="H2" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Serif}"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="FontSize" Value="22"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
        <Style x:Key="Sub" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted2}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="19"/></Style>
        <Style x:Key="Meta" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Mono}"/><Setter Property="FontSize" Value="11.5"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
        <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Mono}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{StaticResource Rule}"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Mono}"/><Setter Property="FontSize" Value="11.5"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,12,0,5"/></Style>
        <Style x:Key="Words" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Serif}"/><Setter Property="FontSize" Value="17.5"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="26"/></Style>

        <!-- ===== a sheet of paper: ink border with a hard offset shadow ===== -->
        <Style x:Key="Sheet" TargetType="ContentControl">
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid Margin="0,0,5,5">
                            <Border Background="{StaticResource Shadow}" CornerRadius="6" Margin="5,5,-5,-5"/>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Blue}" BorderThickness="1.5" CornerRadius="6">
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- older name kept for small boxes (banner, dialogs) -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- ===== buttons ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Blue}"/>
            <Setter Property="FontFamily" Value="{StaticResource UI}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="0,0,3,3">
                            <Border Background="#4D1F3A5F" CornerRadius="6" Margin="3,3,-3,-3"/>
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="RenderTransform"><Setter.Value><TranslateTransform X="2" Y="2"/></Setter.Value></Setter></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource Danger}"/>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource UI}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Blue}" BorderThickness="1.5" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource BlueSoft}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="t" Text="{TemplateBinding Content}" TextDecorations="Underline" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Foreground" Value="{StaticResource Rule}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== notebook tabs ===== -->
        <Style x:Key="NavRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted2}"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,-1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="8,8,0,0" Padding="16,10" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5,1.5,1.5,0">
                            <ContentPresenter VerticalAlignment="Center">
                                <!-- the app-wide TextBlock style would otherwise replace the typewriter font on the tab labels -->
                                <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Mono}"/></Style></ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#80FFFFFF"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="White"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Blue}"/>
                                <Setter Property="Foreground" Value="{StaticResource Blue}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== check boxes: ink square with a tick ===== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontFamily" Value="{StaticResource UI}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="box" Width="17" Height="17" CornerRadius="3" BorderThickness="1.5" BorderBrush="{StaticResource Blue}" Background="White" VerticalAlignment="Top" Margin="0,1,10,0">
                                <Path x:Name="tick" Data="M 3,8 L 6.5,11.5 L 13,4" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Top" RecognizesAccessKey="True">
                                <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontFamily" Value="{StaticResource UI}"/></Style></ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="box" Property="Background" Value="{StaticResource Blue}"/><Setter TargetName="tick" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Rule}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="box" Property="BorderThickness" Value="2.5"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== text boxes: written on a line ===== -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UI}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
            <Setter Property="Padding" Value="2,6"/>
            <Setter Property="CaretBrush" Value="{StaticResource Rule}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Highlight}"/>
        </Style>
        <!-- a shortcut shown as a key cap -->
        <Style x:Key="KeyBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Margin="0,4,2,6" HorizontalAlignment="Left">
                            <Border Background="{StaticResource Blue}" CornerRadius="5" Margin="2,2,-2,-2"/>
                            <Border Background="White" BorderBrush="{StaticResource Blue}" BorderThickness="1.5" CornerRadius="5" Padding="10,4">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== combo boxes ===== -->
        <Style x:Key="ComboToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="White" BorderBrush="{StaticResource Blue}" BorderThickness="1.5" CornerRadius="6">
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Data="M 0,0 L 5,5 L 10,0" Stroke="{StaticResource Blue}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource BlueSoft}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource UI}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="10,7,30,7"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="White" BorderBrush="{StaticResource Blue}" BorderThickness="1.5" CornerRadius="6" Margin="0,4,0,0" Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                                    <ScrollViewer><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource BlueSoft}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== tables (Dictionary, Snippets): a ruled ledger ===== -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontFamily="{StaticResource Mono}" FontSize="11.5"/></DataTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Top"/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource BlueSoft}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#FFFDF6"/>
            <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontFamily" Value="{StaticResource UI}"/>
        </Style>
    </Application.Resources>
</Application>
