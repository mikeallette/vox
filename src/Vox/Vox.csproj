<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Vox</AssemblyName>
    <RootNamespace>Vox</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\vox.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Authors>Mike Allette</Authors>
    <Company>Vox</Company>
    <Copyright>Copyright (c) 2026 Mike Allette. MIT License.</Copyright>
    <AssemblyTitle>Vox - offline voice dictation</AssemblyTitle>
    <RepositoryUrl>https://github.com/mikeallette/vox</RepositoryUrl>
    <Product>Vox</Product>
    <Description>Local, offline voice dictation and meeting transcription</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF + WinForms both define Application, Color, etc.; keep implicit usings unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\vox.ico" />
    <!-- Newsreader and IBM Plex Mono (SIL Open Font License, texts in licenses\) -->
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native speech engine (whisper.cpp release DLLs + Visual C++ runtime), copied to <app>\engine\ -->
    <None Include="..\..\vendor\engine\*" Link="engine\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Small speaker-turn model (pyannote segmentation 3.0, MIT) shipped with the app; the voice-fingerprint model is user-supplied -->
    <!-- Accurate mode: transcribe.cpp v0.4.1 prebuilt (MIT, CPU+Vulkan lane), copied to <app>\asr\ ; runs in a helper process -->
    <None Include="..\..\vendor\asr\**\*" Link="asr\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\vendor\speakers\*" Link="models\speakers\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- License texts for the bundled third-party parts (see licenses\README.txt), copied to <app>\licenses\ -->
    <None Include="..\..\licenses\*" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- Speaker labels in meetings (offline speaker diarization, ONNX Runtime on the CPU). Apache-2.0, k2-fsa/sherpa-onnx. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
  </ItemGroup>

</Project>
